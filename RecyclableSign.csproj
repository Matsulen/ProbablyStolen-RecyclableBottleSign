<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RecyclableSign</AssemblyName>
    <RootNamespace>RecyclableSign</RootNamespace>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- Override with: dotnet build -c Release -p:GameDir="X:\...\Probably Stolen" -->
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <!-- The publishable mod folder (what goes into Mods\ and onto the Workshop). -->
    <DistDir>$(MSBuildProjectDirectory)\dist\RecyclableSign</DistDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Assemble dist\RecyclableSign after every build. -->
  <Target Name="AssembleMod" AfterTargets="Build">
    <ItemGroup>
      <ModItemSprites Include="Textures\Items\*.png" />
      <ModLocalization Include="Localization\*.csv" />
    </ItemGroup>
    <RemoveDir Directories="$(DistDir)" />
    <Copy SourceFiles="$(TargetPath);manifest.xml;preview.png" DestinationFolder="$(DistDir)" />
    <Copy SourceFiles="@(ModItemSprites)" DestinationFolder="$(DistDir)\Textures\Items" />
    <Copy SourceFiles="@(ModLocalization)" DestinationFolder="$(DistDir)\Localization" />
  </Target>

  <!-- dotnet build -c Release -p:Install=true  copies dist into the game's Mods folder. -->
  <Target Name="InstallMod" AfterTargets="AssembleMod" Condition="'$(Install)' == 'true'">
    <ItemGroup>
      <DistFiles Include="$(DistDir)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(GameDir)\Mods\RecyclableSign" />
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="$(GameDir)\Mods\RecyclableSign\%(RecursiveDir)" />
  </Target>

</Project>
